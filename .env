# Necessary variables
# Everything is stored there
STACK=home-media-center
MASTER_FOLDER=/E
MASTER_STACK_DOMAIN=master
HOMEPAGE_VAR_DOMAIN="${MASTER_STACK_DOMAIN}.local"
HOMEPAGE_HOSTNAME=localhost,${HOMEPAGE_VAR_DOMAIN}

# ===== This part can be configured, or can be left as is =====
BACKDROPS_SHARE_USER=admin
BACKDROPS_SHARE_PASSWORD=1111

# Nested folder structure
# Make sure you persist/backup your CONFIGS folder, everything else is recoverable
CONFIGS_FOLDER=${MASTER_FOLDER}/configs
BACKDROPS_FOLDER=${MASTER_FOLDER}/backdrops
CACHE_FOLDER=${MASTER_FOLDER}/cache
HOT_FOLDER=${MASTER_FOLDER}/hot
COLD_FOLDER=${MASTER_FOLDER}/cold

# Optional variables
USER_ID=1000
GROUP_ID=${USER_ID}
#TIMEZONE=Etc/UTC # It's commented-out so that scripts/start.sh will populate it.

# Ports opened in your host system
# Note that jellyfin also opens hardcoded: 8920, 7359, 1900
# (needed for discovery by apps)
HOMEPAGE_PORT=80
GLANCES_PORT=61208
SONARR_PORT=8989
RADARR_PORT=7878
BAZARR_PORT=6767
PROWLARR_PORT=9696
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=33333
SEERR_PORT=5055
JELLYFIN_PORT=8096
JELLYSTAT_PORT=8097

# Homepage additional settings
HOMEPAGE_DISK_STATS_HOT=${HOT_FOLDER}
HOMEPAGE_DISK_STATS_COLD=${COLD_FOLDER}

# ===== Homepage clock + weather =====
HOMEPAGE_CLOCK_ENABLED=true
HOMEPAGE_CLOCK_SHOW_SECONDS=true
HOMEPAGE_CLOCK_HOUR12=false
HOMEPAGE_DATE_ENABLED=true
HOMEPAGE_WEATHER_ENABLED=true
HOMEPAGE_WEATHER_CITY=Minsk
HOMEPAGE_WEATHER_UNITS=metric
HOMEPAGE_WEATHER_FORECAST_DAYS=5
HOMEPAGE_DATETIME_TIMEZONE=Europe/Minsk
# Optional overrides if Open-Meteo geocoding picks the wrong place
HOMEPAGE_WEATHER_LATITUDE=
HOMEPAGE_WEATHER_LONGITUDE=
